NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://pricezap:secret@postgres:5432/pricezap

REDIS_URL=redis://redis:6379

JWT_SECRET=change_me_in_production_use_long_random_string
JWT_REFRESH_SECRET=change_me_refresh_use_different_long_random_string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Cron schedule for price scraping (default: every 30 minutes)
SCRAPE_CRON=*/30 * * * *
